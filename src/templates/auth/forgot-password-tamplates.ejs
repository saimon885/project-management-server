<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Your Password</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      font-family:
        -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto,
        Helvetica, Arial, sans-serif;
      background-color: #f8fafc;
      color: #334155;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      border="0"
      style="background-color: #f8fafc; padding: 50px 0"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="600"
            cellspacing="0"
            cellpadding="0"
            border="0"
            style="
              background-color: #ffffff;
              border-radius: 12px;
              border: 1px solid #e2e8f0;
              overflow: hidden;
            "
          >
            <tr>
              <td style="padding: 40px 40px 20px 40px; text-align: left">
                <div
                  style="
                    font-size: 14px;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 1.5px;
                    color: #6366f1;
                    margin-bottom: 12px;
                  "
                >
                  Project Management System
                </div>
                <h1
                  style="
                    margin: 0;
                    color: #0f172a;
                    font-size: 28px;
                    font-weight: 800;
                    line-height: 1.2;
                  "
                >
                  Password Reset Request 🔐
                </h1>
              </td>
            </tr>

            <tr>
              <td style="padding: 20px 40px 40px 40px">
                <p
                  style="
                    margin: 0 0 20px 0;
                    font-size: 16px;
                    line-height: 1.6;
                    color: #475569;
                  "
                >
                  Hello <strong><%= name %></strong>,
                </p>
                <p
                  style="
                    margin: 0 0 24px 0;
                    font-size: 16px;
                    line-height: 1.6;
                    color: #475569;
                  "
                >
                  We received a request to reset the password for your account.
                  Please use the following One-Time Password (OTP) to complete
                  your password reset process.
                </p>

                <table
                  role="presentation"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                  style="
                    margin: 24px 0;
                    background-color: #f1f5f9;
                    border-radius: 8px;
                    width: 100%;
                  "
                >
                  <tr>
                    <td align="center" style="padding: 20px">
                      <div
                        style="
                          font-size: 32px;
                          font-weight: 800;
                          letter-spacing: 6px;
                          color: #4f46e5;
                        "
                      >
                        <%= OTP %>
                      </div>
                      <div
                        style="
                          font-size: 13px;
                          color: #64748b;
                          margin-top: 8px;
                          font-weight: 500;
                        "
                      >
                        This OTP is valid for <%= expiryMinutes %> minutes.
                      </div>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    margin: 0 0 32px 0;
                    font-size: 15px;
                    line-height: 1.6;
                    color: #64748b;
                  "
                >
                  If you did not request a password reset, please ignore this
                  email or contact support if you have questions. Your password
                  will remain unchanged.
                </p>

                <p
                  style="
                    margin: 0;
                    font-size: 15px;
                    color: #64748b;
                    line-height: 1.6;
                  "
                >
                  Best regards,<br />
                  <span style="font-weight: 600; color: #0f172a"
                    >The Operations Team</span
                  >
                </p>
              </td>
            </tr>

            <tr>
              <td
                style="
                  padding: 32px 40px;
                  background-color: #f1f5f9;
                  border-top: 1px solid #e2e8f0;
                  text-align: left;
                "
              >
                <p
                  style="
                    margin: 0 0 8px 0;
                    font-size: 13px;
                    line-height: 1.5;
                    color: #64748b;
                  "
                >
                  You are receiving this automated transactional email because a
                  password reset request was triggered for your profile.
                </p>
                <p style="margin: 0; font-size: 12px; color: #94a3b8">
                  &copy; <%= year %> Workspace Enterprise. All rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
