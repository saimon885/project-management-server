<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Your Email</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      font-family: &quot;Segoe UI&quot;, Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f4f7f6;
      color: #333333;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      border="0"
      style="background-color: #f4f7f6; padding: 40px 0"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="600"
            cellspacing="0"
            cellpadding="0"
            border="0"
            style="
              background-color: #ffffff;
              border-radius: 8px;
              box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
              overflow: hidden;
            "
          >
            <!-- Header -->
            <tr>
              <td
                style="
                  background-color: #4f46e5;
                  padding: 30px;
                  text-align: center;
                "
              >
                <h1
                  style="
                    margin: 0;
                    color: #ffffff;
                    font-size: 24px;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                  "
                >
                  Project Management System
                </h1>
              </td>
            </tr>

            <!-- Body Content -->
            <tr>
              <td style="padding: 40px 30px">
                <h2
                  style="
                    margin: 0 0 20px 0;
                    color: #111111;
                    font-size: 20px;
                    font-weight: 600;
                  "
                >
                  Hello <%= name %>,
                </h2>
                <p
                  style="
                    margin: 0 0 25px 0;
                    font-size: 16px;
                    line-height: 1.6;
                    color: #555555;
                  "
                >
                  Thank you for registering with us! To complete your sign-up
                  process and verify your email address, please use the One-Time
                  Password (OTP) provided below.
                </p>

                <!-- OTP Box -->
                <table
                  role="presentation"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                  align="center"
                  style="margin: 30px auto"
                >
                  <tr>
                    <td
                      align="center"
                      style="
                        background-color: #f3f4f6;
                        border: 1px dashed #4f46e5;
                        border-radius: 6px;
                        padding: 15px 40px;
                      "
                    >
                      <span
                        style="
                          font-family:
                            &quot;Courier New&quot;, Courier, monospace;
                          font-size: 32px;
                          font-weight: bold;
                          letter-spacing: 6px;
                          color: #4f46e5;
                        "
                      >
                        <%= OTP %>
                      </span>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    margin: 25px 0 0 0;
                    font-size: 14px;
                    line-height: 1.5;
                    color: #ef4444;
                    font-weight: 500;
                    text-align: center;
                  "
                >
                  ⚠️ This OTP is valid for <%= expireMinutes %> minutes only. Do
                  not share this code with anyone.
                </p>
              </td>
            </tr>

            <!-- Divider -->
            <tr>
              <td style="padding: 0 30px">
                <hr
                  style="border: 0; border-top: 1px solid #e5e7eb; margin: 0"
                />
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style="
                  padding: 30px;
                  text-align: center;
                  background-color: #fafafa;
                "
              >
                <p style="margin: 0 0 10px 0; font-size: 14px; color: #888888">
                  If you did not request this email, you can safely ignore it.
                </p>
                <p style="margin: 0; font-size: 13px; color: #b5b5b5">
                  &copy; <%= year %> Project Management System. All rights
                  reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
