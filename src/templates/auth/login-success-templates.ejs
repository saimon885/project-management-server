<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Security Notification: Login Detected</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      font-family:
        -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto,
        Helvetica, Arial, sans-serif;
      background-color: #f8fafc;
      color: #334155;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      border="0"
      style="background-color: #f8fafc; padding: 50px 0"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="600"
            cellspacing="0"
            cellpadding="0"
            border="0"
            style="
              background-color: #ffffff;
              border-radius: 12px;
              border: 1px solid #e2e8f0;
              overflow: hidden;
            "
          >
            <!-- Header with Security Theme Accent -->
            <tr>
              <td style="padding: 40px 40px 20px 40px; text-align: left">
                <div
                  style="
                    font-size: 14px;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 1.5px;
                    color: #f59e0b;
                    margin-bottom: 12px;
                  "
                >
                  Security Alert
                </div>
                <h1
                  style="
                    margin: 0;
                    color: #0f172a;
                    font-size: 26px;
                    font-weight: 800;
                    line-height: 1.2;
                  "
                >
                  Successful Login Notification
                </h1>
              </td>
            </tr>

            <!-- Main Body -->
            <tr>
              <td style="padding: 20px 40px 40px 40px">
                <p
                  style="
                    margin: 0 0 20px 0;
                    font-size: 16px;
                    line-height: 1.6;
                    color: #475569;
                  "
                >
                  Dear <strong><%= name %></strong>,
                </p>
                <p
                  style="
                    margin: 0 0 24px 0;
                    font-size: 16px;
                    line-height: 1.6;
                    color: #475569;
                  "
                >
                  This security notification confirms a recent successful
                  authentication on your account (<strong><%= email %></strong>)
                  within the Project Management Platform.
                </p>

                <!-- Modern Minimal Info Callout Box -->
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                  style="
                    background-color: #f8fafc;
                    border-left: 4px solid #cbd5e1;
                    border-radius: 4px;
                    margin: 24px 0;
                  "
                >
                  <tr>
                    <td style="padding: 16px 20px">
                      <p
                        style="
                          margin: 0 0 6px 0;
                          font-size: 13px;
                          font-weight: 600;
                          text-transform: uppercase;
                          letter-spacing: 0.5px;
                          color: #64748b;
                        "
                      >
                        Status
                      </p>
                      <p
                        style="
                          margin: 0;
                          font-size: 15px;
                          font-weight: 500;
                          color: #0f172a;
                        "
                      >
                        Authorized Session Connected
                      </p>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    margin: 0 0 24px 0;
                    font-size: 14px;
                    line-height: 1.6;
                    color: #64748b;
                  "
                >
                  If this action was performed by you, no response is necessary.
                  Your session is safe.
                </p>

                <!-- Critical Risk Warning -->
                <div
                  style="
                    border-top: 1px dashed #e2e8f0;
                    margin-top: 30px;
                    padding-top: 20px;
                  "
                >
                  <p
                    style="
                      margin: 0;
                      font-size: 13px;
                      line-height: 1.5;
                      color: #dc2626;
                      font-weight: 500;
                    "
                  >
                    ⚠️ <strong>Important Security Notice:</strong> If you did
                    not log in recently or suspect unauthorized access to your
                    credential set, please initiate an immediate password reset
                    via your security settings panel.
                  </p>
                </div>
              </td>
            </tr>

            <!-- Clean Technical Footer -->
            <tr>
              <td
                style="
                  padding: 32px 40px;
                  background-color: #f1f5f9;
                  border-top: 1px solid #e2e8f0;
                  text-align: left;
                "
              >
                <p
                  style="
                    margin: 0 0 8px 0;
                    font-size: 13px;
                    line-height: 1.5;
                    color: #64748b;
                  "
                >
                  This security metric cannot be disabled. It is a vital system
                  message sent to safeguard your deployment.
                </p>
                <p style="margin: 0; font-size: 12px; color: #94a3b8">
                  &copy; <%= year %> Workspace Enterprise. All rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
