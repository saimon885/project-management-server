
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="x-apple-disable-message-reformatting">
  <title>Payment Confirmation</title>
</head>

<body style="margin:0; padding:0; background-color:#f3f5f9; font-family:Arial, Helvetica, sans-serif; color:#1e293b;">

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f3f5f9; padding:30px 12px;">
    <tr>
      <td align="center">

        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; background-color:#ffffff; border-radius:12px; overflow:hidden;">

          <!-- Header -->
          <tr>
            <td align="center" style="background-color:#172554; padding:30px 20px;">
              <div style="font-size:23px; font-weight:bold; color:#ffffff; letter-spacing:-0.5px;">
                Project Management
              </div>
              <div style="font-size:12px; color:#cbd5e1; padding-top:8px;">
                Plan better. Work smarter. Achieve more.
              </div>
            </td>
          </tr>

          <!-- Success Section -->
          <tr>
            <td align="center" style="padding:35px 25px 20px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center" width="58" height="58" style="width:58px; height:58px; background-color:#dcfce7; border-radius:50%; color:#15803d; font-size:30px; font-weight:bold;">
                    &#10003;
                  </td>
                </tr>
              </table>

              <h1 style="margin:20px 0 10px; font-size:25px; line-height:32px; color:#0f172a;">
                Payment Successful!
              </h1>

              <p style="margin:0; font-size:14px; line-height:23px; color:#64748b;">
                Your payment has been successfully received.
                Your organization subscription is now active.
              </p>
            </td>
          </tr>

          <!-- Greeting -->
          <tr>
            <td style="padding:15px 30px 20px;">
              <p style="margin:0 0 12px; font-size:15px; line-height:23px; color:#334155;">
                Hello <strong><%= name %></strong>,
              </p>

              <p style="margin:0; font-size:14px; line-height:23px; color:#64748b;">
                Thank you for choosing Project Management. We appreciate your trust in our platform. Below is your payment confirmation and subscription information.
              </p>
            </td>
          </tr>

          <!-- Amount Highlight -->
          <tr>
            <td style="padding:0 25px 22px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f0fdf4; border:1px solid #bbf7d0; border-radius:10px;">
                <tr>
                  <td align="center" style="padding:22px 15px;">
                    <p style="margin:0 0 8px; font-size:12px; color:#64748b; text-transform:uppercase; letter-spacing:1px;">
                      Total Amount Paid
                    </p>

                    <p style="margin:0; font-size:30px; line-height:38px; font-weight:bold; color:#15803d;">
                      ৳<%= amount %>
                    </p>

                    <p style="margin:7px 0 0; font-size:12px; color:#15803d;">
                      Payment completed successfully
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Payment Details -->
          <tr>
            <td style="padding:0 25px 22px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #e2e8f0; border-radius:9px;">

                <tr>
                  <td colspan="2" style="padding:18px 18px 12px; font-size:16px; font-weight:bold; color:#0f172a;">
                    Payment Summary
                  </td>
                </tr>

                <% const paymentDetails = [
                  ["Organization", organizationName],
                  ["Subscription Plan", plan],
                  ["Billing Duration", billingCycle],
                  ["Transaction ID", trxID],
                  ["Invoice Number", invoiceNumber],
                  ["Payment Date", paymentDate]
                ]; %>

                <% paymentDetails.forEach(function(item, index) { %>
                  <tr>
                    <td width="42%" valign="top" style="padding:11px 10px 11px 18px; border-top:1px solid #f1f5f9; font-size:13px; line-height:19px; color:#64748b;">
                      <%= item[0] %>
                    </td>
                    <td width="58%" valign="top" align="right" style="padding:11px 18px 11px 10px; border-top:1px solid #f1f5f9; font-size:13px; line-height:19px; font-weight:bold; color:#334155; word-break:break-word;">
                      <%= item[1] %>
                    </td>
                  </tr>
                <% }); %>

                <tr>
                  <td style="padding:13px 10px 16px 18px; border-top:1px solid #f1f5f9; font-size:13px; color:#64748b;">
                    Payment Status
                  </td>
                  <td align="right" style="padding:13px 18px 16px 10px; border-top:1px solid #f1f5f9;">
                    <span style="display:inline-block; padding:5px 12px; background-color:#dcfce7; border-radius:20px; color:#15803d; font-size:11px; font-weight:bold;">
                      PAID
                    </span>
                  </td>
                </tr>

              </table>
            </td>
          </tr>

          <!-- Subscription Details -->
          <tr>
            <td style="padding:0 25px 25px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #e2e8f0; border-radius:9px;">

                <tr>
                  <td colspan="2" style="padding:18px; font-size:16px; font-weight:bold; color:#0f172a;">
                    Subscription Details
                  </td>
                </tr>

                <tr>
                  <td width="42%" style="padding:12px 10px 12px 18px; border-top:1px solid #f1f5f9; font-size:13px; color:#64748b;">
                    Plan Starts
                  </td>
                  <td width="58%" align="right" style="padding:12px 18px 12px 10px; border-top:1px solid #f1f5f9; font-size:13px; font-weight:bold; color:#334155;">
                    <%= subscriptionStart %>
                  </td>
                </tr>

                <tr>
                  <td style="padding:12px 10px 16px 18px; border-top:1px solid #f1f5f9; font-size:13px; color:#64748b;">
                    Plan Expires
                  </td>
                  <td align="right" style="padding:12px 18px 16px 10px; border-top:1px solid #f1f5f9; font-size:13px; font-weight:bold; color:#334155;">
                    <%= subscriptionEnd %>
                  </td>
                </tr>

              </table>
            </td>
          </tr>

          <!-- Information -->
          <tr>
            <td style="padding:0 25px 30px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#eff6ff; border-left:4px solid #2563eb;">
                <tr>
                  <td style="padding:16px; font-size:13px; line-height:21px; color:#475569;">
                    <strong style="color:#1e40af;">What's next?</strong><br>
                    Your subscription is ready to use. You can now continue managing your organization's teams, projects and tasks with your selected plan.
                    Please keep this email for your records.
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="background-color:#f8fafc; border-top:1px solid #e2e8f0; padding:25px 20px;">

              <p style="margin:0 0 10px; font-size:13px; line-height:21px; color:#64748b;">
                Need assistance? Contact our support team for help with your subscription or payment.
              </p>

              <p style="margin:15px 0 5px; font-size:12px; color:#334155; font-weight:bold;">
                Project Management
              </p>

              <p style="margin:0; font-size:11px; line-height:19px; color:#94a3b8;">
                &copy; <%= year %> Project Management. All rights reserved.
              </p>

              <p style="margin:8px 0 0; font-size:11px; color:#94a3b8;">
                This is an automated email. Please do not reply.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
