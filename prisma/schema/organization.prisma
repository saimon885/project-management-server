model Organization {
    id               String   @id @default(uuid())
    name             String
    slug             String   @unique
    logoUrl          String?
    logoPublishedID String   @default("")
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    members OrganizationMember[]
    inviteation Invitation[]

    @@map("organizations")
}
