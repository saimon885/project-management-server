model Organization {
    id              String   @id @default(uuid())
    name            String
    slug            String   @unique
    logoUrl         String?
    logoPublishedID String   @default("")
    status          Boolean  @default(true)
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    members     OrganizationMember[]
    projects    Project[]
    inviteation Invitation[]
    team Team[]

    @@map("organizations")
}
