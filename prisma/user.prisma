model User {
    id           String   @id @default(uuid())
    name         String
    email        String   @unique
    password     String?
    role         UserRole @default(GUEST)
    image_url    String?
    phone_number String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@index([email])
    @@map("users")
}
